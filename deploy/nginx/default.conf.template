# GateFlow 统一入口（模板：${GATEFLOW_ADMIN_TOKEN} 在容器启动时由环境变量替换——
# nginx 官方镜像对 /etc/nginx/templates/*.template 做 envsubst 后写入 conf.d）
# 安全基线（2026-10 审查报告严重 1/2 的修复）：
#   - /api/ 不再对外转发：工具接口只允许网关经容器内部网络调用，外部一律 404
#   - /conductor/（审批写操作）与管理端点一样要求 X-Admin-Token 请求头
#   - /mcp 补齐 SSE 所需配置（proxy_buffering off + 长读超时）

server {
    listen 80;

    # MCP 协议入口 -> gateway（响应可能是 SSE 流：禁缓冲 + 长读超时，同 /stream/）
    location /mcp {
        proxy_pass http://gateway:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # 知识库热重载 -> workers（workers 侧另有 X-Admin-Token 校验；此路径不进网关）
    location /admin/knowledge/ {
        proxy_pass http://workers:8081;
    }

    # 令牌签发/审计流水/统计 -> gateway（gateway 侧另有 X-Admin-Token 校验）
    location /admin/ {
        proxy_pass http://gateway:8090;
        proxy_set_header Host $host;
    }

    # SSE 流式问答 -> workers（禁缓冲 + 长读超时 + 1.1 保持连接；workers 侧校验 X-Admin-Token）
    location /stream/ {
        proxy_pass http://workers:8081;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_read_timeout 300s;
    }

    # Conductor API（面板看板数据源/审批动作）——无口令直接 401
    location /conductor/ {
        if ($http_x_admin_token != "${GATEFLOW_ADMIN_TOKEN}") {
            return 401;
        }
        proxy_pass http://conductor:8080/;
        proxy_set_header Host $host;
    }

    # 面板静态资源（Vue3 构建产物，构建见 panel/README 说明；仓库附带预构建 dist）
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
