[
  {
    "name": "draft_review",
    "description": "W2 final: RAG draft -> human approval -> APPROVED: persist+ticket / REJECTED: no write",
    "version": 2,
    "schemaVersion": 2,
    "restartable": true,
    "tasks": [
      {
        "name": "rag_retriever",
        "taskReferenceName": "rag_ref",
        "inputParameters": {
          "question": "${workflow.input.question}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "llm_answer",
        "taskReferenceName": "llm_ref",
        "inputParameters": {
          "question": "${workflow.input.question}",
          "chunks": "${rag_ref.output.chunks}",
          "workflowId": "${workflow.workflowId}"
        },
        "type": "SIMPLE",
        "taskDefinition": {
          "name": "llm_answer",
          "retryCount": 2,
          "timeoutSeconds": 120,
          "responseTimeoutSeconds": 30,
          "timeoutPolicy": "TIME_OUT_WF",
          "retryLogic": "FIXED",
          "retryDelaySeconds": 5
        }
      },
      {
        "name": "human_review",
        "taskReferenceName": "review_ref",
        "inputParameters": {
          "question": "${workflow.input.question}",
          "draft": "${llm_ref.output.answer}"
        },
        "type": "HUMAN"
      },
      {
        "name": "decision_switch",
        "taskReferenceName": "switch_ref",
        "type": "SWITCH",
        "evaluatorType": "value-param",
        "expression": "decision",
        "inputParameters": {
          "decision": "${review_ref.output.decision}"
        },
        "decisionCases": {
          "APPROVED": [
            {
              "name": "persist_draft",
              "taskReferenceName": "save_ref",
              "inputParameters": {
                "workflowId": "${workflow.workflowId}",
                "question": "${workflow.input.question}",
                "draft": "${llm_ref.output.answer}",
                "comment": "${review_ref.output.comment}"
              },
              "type": "SIMPLE"
            },
            {
              "name": "ticket_create",
              "taskReferenceName": "ticket_ref",
              "inputParameters": {
                "title": "[报销申请] ${workflow.input.question}",
                "content": "${llm_ref.output.answer}"
              },
              "type": "SIMPLE"
            }
          ],
          "REJECTED": [
            {
              "name": "echo_demo",
              "taskReferenceName": "rej_ref",
              "inputParameters": {
                "text": "草稿已驳回：${review_ref.output.comment}"
              },
              "type": "SIMPLE"
            }
          ]
        },
        "defaultCase": [
          {
            "name": "echo_demo",
            "taskReferenceName": "def_ref",
            "inputParameters": {
              "text": "未知审批结果，默认不落库"
            },
            "type": "SIMPLE"
          }
        ]
      }
    ],
    "outputParameters": {
      "decision": "${review_ref.output.decision}",
      "comment": "${review_ref.output.comment}",
      "record_id": "${save_ref.output.recordId}",
      "ticket_id": "${ticket_ref.output.ticketId}"
    }
  }
]