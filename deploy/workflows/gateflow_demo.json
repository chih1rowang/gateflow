[
  {
    "name": "gateflow_demo",
    "description": "W1 Day3: question -> llm_answer (DeepSeek) -> echo (day5 will prepend rag_retriever)",
    "version": 2,
    "schemaVersion": 2,
    "restartable": true,
    "tasks": [
      {
        "name": "llm_answer",
        "taskReferenceName": "llm_ref",
        "inputParameters": {
          "question": "${workflow.input.question}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "echo_demo",
        "taskReferenceName": "echo_ref",
        "inputParameters": {
          "text": "${llm_ref.output.answer}"
        },
        "type": "SIMPLE"
      }
    ],
    "outputParameters": {
      "answer": "${echo_ref.output.echoed}"
    }
  }
]
