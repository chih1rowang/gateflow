[
  {
    "name": "gateflow_demo",
    "description": "W1 final: rag_retriever -> llm_answer -> echo (full RAG pipeline)",
    "version": 3,
    "schemaVersion": 2,
    "restartable": true,
    "tasks": [
      {
        "name": "rag_retriever",
        "taskReferenceName": "rag_ref",
        "inputParameters": {
          "question": "${workflow.input.question}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "llm_answer",
        "taskReferenceName": "llm_ref",
        "inputParameters": {
          "question": "${workflow.input.question}",
          "chunks": "${rag_ref.output.chunks}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "echo_demo",
        "taskReferenceName": "echo_ref",
        "inputParameters": {
          "text": "${llm_ref.output.answer}"
        },
        "type": "SIMPLE"
      }
    ],
    "outputParameters": {
      "answer": "${echo_ref.output.echoed}"
    }
  }
]
